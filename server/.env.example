# ─────────────────────────────────────────────────────────────
# Druckwelt Erding – Anfrage-API
# Kopieren nach .env und anpassen. Die Datei .env nie committen.
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
# Hinter Reverse Proxy (nginx, Plesk, Render …) auf 1 setzen, damit die Client-IP stimmt
TRUST_PROXY=0
# Liefert zusätzlich die statische Website aus (praktisch lokal / auf einem einzelnen Server)
SERVE_STATIC=true
# Nur nötig, wenn Website und API auf unterschiedlichen Domains laufen (kommagetrennt)
CORS_ORIGINS=

# Ablage: jede Anfrage bekommt einen eigenen Ordner mit anfrage.json + Dateien
STORAGE_DIR=./storage
# Anfragen nach X Tagen automatisch löschen (DSGVO). 0 = nie
RETENTION_DAYS=90

# Upload-Grenzen (müssen zu data-max-* im Formular in index.html passen)
MAX_FILES=10
MAX_FILE_MB=25
MAX_TOTAL_MB=80

# Spam-Schutz: max. Anfragen pro IP im Zeitfenster
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# ── Kanal 1: E-Mail ───────────────────────────────────────────
MAIL_ENABLED=true
# smtp = echter Versand | file = schreibt .eml-Dateien nach STORAGE_DIR/outbox (Test/Demo)
MAIL_TRANSPORT=file
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Druckwelt Erding Website <website@druckwelt-erding.de>"
# Empfänger der internen Benachrichtigung (kommagetrennt)
MAIL_TO=shop@druckwelt-erding.de
# Automatische Eingangsbestätigung an den Kunden
MAIL_CONFIRMATION=true
# Bis zu dieser Gesamtgröße werden Dateien an die interne Mail angehängt, darüber nur aufgelistet
MAIL_MAX_ATTACHMENT_MB=20

# ── Kanal 2: Webhook (z. B. n8n, Make, Zapier) ────────────────
WEBHOOK_ENABLED=false
WEBHOOK_URL=
# Gemeinsames Geheimnis: Signatur im Header X-Druckwelt-Signature (HMAC-SHA256)
WEBHOOK_SECRET=
# true = Dateien als multipart mitsenden | false = nur JSON mit Datei-Metadaten
WEBHOOK_INCLUDE_FILES=true

# ── Kanal 3: Internes Auftragsprogramm ────────────────────────
# Vorbereitet in src/dispatchers/internal.js – Anbindung folgt, sobald Schnittstelle bekannt ist
INTERNAL_ENABLED=false
INTERNAL_API_URL=
INTERNAL_API_KEY=
